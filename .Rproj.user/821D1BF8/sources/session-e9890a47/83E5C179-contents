# Test the Daymet endpoint without following redirects
url <- sprintf(DAYMET_NCSS, 2000)

q <- list(
  var = "prcp",
  north = "39.0",
  west = "-77.2",
  east = "-76.8",
  south = "38.7",
  disableProjSubset = "on",
  horizStride = 1,
  time_start = "2000-01-01T12:00:00Z",
  time_end = "2000-01-01T12:00:00Z",
  timeStride = 1,
  accept = "netcdf"
)

test <- httr::GET(
  url,
  query = q,
  httr::timeout(60),
  httr::user_agent("DCFloodR diagnostic"),
  httr::config(followlocation = FALSE)
)

cat("HTTP status:", httr::status_code(test), "\n")
cat("Requested URL:", url, "\n")
cat("Response URL:", test$url, "\n")
cat("Redirect location:\n")
print(httr::headers(test)[["location"]])
cat("Content type:\n")
print(httr::headers(test)[["content-type"]])


redirect_url <- httr::headers(test)[["location"]]

direct_test <- httr::GET(
  redirect_url,
  httr::timeout(60),
  httr::user_agent("DCFloodR diagnostic"),
  httr::config(followlocation = FALSE)
)

cat("HTTP status:", httr::status_code(direct_test), "\n")
cat("Response URL:", direct_test$url, "\n")
cat("Redirect location:\n")
print(httr::headers(direct_test)[["location"]])

cat("Response preview:\n")
cat(
  substr(
    rawToChar(httr::content(direct_test, "raw")),
    1, 400
  ),
  "\n"
)


